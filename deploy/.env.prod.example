# Generated by deploy/install.sh as deploy/.env (chmod 0600).
NODE_ENV=production

# Deployment metadata
OPENPDF_DOMAIN=             # empty => HTTP-only on port 5000; or domain for auto-HTTPS
OPENPDF_ACME_EMAIL=        # required only when OPENPDF_DOMAIN is set
HTTP_PUBLISH=5000          # host port Caddy listens on (default 5000)
